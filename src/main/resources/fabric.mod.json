{
  "schemaVersion": 1,
  "id": "velonet",
  "provides": [
    "krypton",
    "kryptonplus"
  ],
  "version": "${version}",
  "name": "VeloNet",
  "description": "An independent Fabric network stack optimization mod forked from Krypton, featuring ViaFabricPlus 5.1.3, PacketFixer, e4mc, and Eunomia compatibility.",
  "authors": [
    "Kazim"
  ],
  "contributors": [
    "Andrew Steinborn (tuxed) - Original Krypton author"
  ],
  "contact": {
    "homepage": "https://github.com/Qazcto7/VeloNet",
    "sources": "https://github.com/Qazcto7/VeloNet",
    "issues": "https://github.com/Qazcto7/VeloNet/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/velonet/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.qazcto7.velonet.mod.client.VeloNetClientInitializer"
    ],
    "server": [
      "io.github.qazcto7.velonet.mod.server.VeloNetServerInitializer"
    ],
    "main": [
      "io.github.qazcto7.velonet.mod.shared.VeloNetSharedInitializer"
    ]
  },
  "mixins": [
    "velonet.mixins.json"
  ],
  "accessWidener": "velonet.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": ">=26.3"
  }
}
